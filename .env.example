# ============================================================================
# SENTINEL OSINT — Environment configuration template
# Copy to `.env` and fill in values. Never commit real keys.
# ============================================================================

# ----- Server ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Application URLs (Used for enrollment links and client configuration)
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
WEBSOCKET_URL=http://localhost:4000

# ----- Authentication --------------------------------------------------------
# Long random string (>= 32 chars). `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
# Make the demo/investigator user available (development only)
DEMO_ENABLED=true

# ----- Database --------------------------------------------------------------
DATABASE_URL=postgresql://osint:osint@localhost:5432/osint?schema=public

# ----- Bootstrap admin (used by `npm run db:seed`) ---------------------------
ADMIN_EMAIL=admin@sentinel.local
ADMIN_PASSWORD=ChangeMe!12345

# ----- Investigation engine ---------------------------------------------------
MOCK_MODE=true
REQUEST_TIMEOUT_MS=8000
MAX_RETRIES=2
RETRY_BACKOFF_BASE_MS=500

# ----- Rate limiting ----------------------------------------------------------
# Global per-IP limiter
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
# Per-user investigation limiter
INVESTIGATION_RATE_LIMIT_WINDOW_MS=3600000
INVESTIGATION_RATE_LIMIT_MAX=60
# Auth (login) limiter
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=60

# ----- End-user portal (USER role) ----------------------------------------------
# Current consent / privacy policy versions stamped on new permission records
CONSENT_VERSION=1.0
PRIVACY_POLICY_VERSION=1.0
# Per-IP registration limiter
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=10
# Per-user camera session limiter
CAMERA_RATE_LIMIT_WINDOW_MS=60000
CAMERA_RATE_LIMIT_MAX=30
# Minimum interval (ms) enforced between user dashboard location pushes
USER_LOCATION_INTERVAL_MS=10000
# Enable/disable public self-registration (false in strict deployments)
REGISTRATION_ENABLED=true

# ----- Live location ----------------------------------------------------------
# Per-device location push limiter
LOCATION_PUSH_RATE_LIMIT_WINDOW_MS=60000
LOCATION_PUSH_RATE_LIMIT_MAX=120
# A device is offline when no fix arrives within this window
LOCATION_OFFLINE_THRESHOLD_MS=45000
# Reject GPS timestamps older than this skew
LOCATION_MAX_TS_SKEW_MS=600000
# Max history points returned per request
LOCATION_HISTORY_MAX_POINTS=2000

# ----- API keys (all OPTIONAL — app falls back to mock providers) ------------
HIBP_API_KEY=
HUNTER_API_KEY=
ABSTRACT_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# ----- Frontend (Vite, public at build time) ---------------------------------
# CARTO basemap key from https://account.carto.com. Optional: without it the
# Voyager raster basemap renders as blank tiles and the Dark basemap still
# works. This is a client-side basemap credential, not a secret — the browser
# requests map tiles directly with it.
VITE_CARTO_API_KEY=
